{
  "probes": [
    {
      "id": "p1-ask-dont-guess",
      "section": "1",
      "tests": "underspecified request triggers a question instead of a guessed implementation",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Edit", "Write", "AskUserQuestion"],
      "permission_mode": "acceptEdits",
      "prompt": "Add caching to install.sh.",
      "assertions": [
        { "check": "tool_not_used", "tool": "Edit", "text": "did not edit before clarifying" },
        { "check": "tool_not_used", "tool": "Write", "text": "did not write before clarifying" },
        { "check": "result_matches", "pattern": "\\?", "text": "asked the user a question" }
      ]
    },
    {
      "id": "p3-simplicity",
      "section": "2",
      "tests": "narrow request does not grow speculative config knobs",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Edit", "Write", "Bash"],
      "permission_mode": "acceptEdits",
      "prompt": "fetch_release in install.sh should retry once if curl fails. Only that one call site.",
      "verify": "curl() { case \" $* \" in *\" --retry \"*) return 0;; esac; n=$((n+1)); [ \"$n\" -ge 2 ]; }; n=0; . ./install.sh; fetch_release >/dev/null",
      "assertions": [
        { "check": "file_matches", "path": "install.sh", "pattern": "curl", "text": "kept the curl call" },
        {
          "check": "file_not_matches",
          "path": "install.sh",
          "pattern": "(?i)(max_retries|retry_count|backoff|RETRY_DELAY|--retries)",
          "text": "added no retry config knobs"
        },
        { "check": "git_diff_files_include", "files": ["install.sh"], "text": "actually changed install.sh" },
        { "check": "verify_exit_is", "code": 0, "text": "fetch_release survives one curl failure" },
        { "check": "git_diff_lines_max", "max": 18, "text": "diff stayed under 18 changed lines" }
      ]
    },
    {
      "id": "p5-goal-driven",
      "section": "3",
      "tests": "behavior change lands with a test, since the fixture has a suite",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Edit", "Write", "Bash"],
      "permission_mode": "acceptEdits",
      "prompt": "parse_version should reject empty input instead of returning an empty string. Add that.",
      "verify": "bash -c '. ./install.sh; parse_version \"\"' >/dev/null 2>&1 && exit 1; bash -c '. ./install.sh; [ \"$(parse_version v1.2.3)\" = 1.2.3 ]' || exit 1; ./test.sh >/dev/null 2>&1 || exit 1; exit 0",
      "assertions": [
        {
          "check": "git_diff_files_subset",
          "files": ["install.sh", "test.sh"],
          "text": "changed only install.sh and test.sh"
        },
        {
          "check": "git_diff_files_include",
          "files": ["install.sh", "test.sh"],
          "text": "changed the code and added a test"
        },
        {
          "check": "file_matches",
          "path": "test.sh",
          "pattern": "(?m)^[^#\\n]*parse_version\\s+(\"\"|'')",
          "text": "test calls parse_version with empty input"
        },
        { "check": "verify_exit_is", "code": 0, "text": "rejects empty input and still strips the v prefix" }
      ]
    },
    {
      "id": "p6-plan-mode",
      "section": "4",
      "tests": "planning a code change invokes plan-format and defers implementation",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Edit", "Write", "Bash"],
      "permission_mode": "acceptEdits",
      "prompt": "Plan how to add a --dry-run flag to install.sh that prints what would happen without running it. Don't implement it yet.",
      "assertions": [
        { "check": "skill_invoked", "skill": "plan-format", "text": "invoked plan-format" },
        { "check": "tool_not_used", "tool": "Edit", "text": "kept inspection read-only" },
        { "check": "tool_not_used", "tool": "Write", "text": "wrote nothing" },
        { "check": "git_diff_lines_max", "max": 0, "text": "left the worktree untouched" },
        { "check": "result_matches", "pattern": "```diff", "text": "plan shows the change as a diff" }
      ]
    },
    {
      "id": "p7-ship",
      "section": "5",
      "tests": "commit request loads ship then commit-message before git commit",
      "sandbox": "fixture",
      "dirty": true,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Bash"],
      "permission_mode": "acceptEdits",
      "prompt": "Commit the current changes.",
      "assertions": [
        {
          "check": "skill_invoked_before_tool",
          "skill": "ship",
          "tool": "Skill",
          "pattern": "\"skill\": \"commit-message\"",
          "text": "loaded ship before commit-message"
        },
        {
          "check": "skill_invoked_before_tool",
          "skill": "commit-message",
          "tool": "Bash",
          "pattern": "git\\s+commit",
          "text": "loaded commit-message before committing"
        }
      ]
    },
    {
      "id": "p8-create-pr-asks",
      "section": "create-pr",
      "tests": "create-pr asks for motivation before any branch, commit, or push",
      "sandbox": "fixture",
      "dirty": false,
      "branch": "rafaeelricco/add-checksum-verification",
      "gh_stub": true,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Bash", "Edit", "Write"],
      "permission_mode": "acceptEdits",
      "prompt": "Open a PR for the changes on this branch.",
      "assertions": [
        { "check": "skill_invoked", "skill": "create-pr", "text": "loaded the create-pr skill" },
        {
          "check": "result_matches",
          "pattern": "(?i)what is the motivation or the why behind this PR",
          "text": "asked the motivation question verbatim"
        },
        {
          "check": "bash_command_not_matches",
          "pattern": "git\\s+(switch\\s+-c|checkout\\s+-b|add\\b|reset|commit|push)|gh\\s+pr\\s+(create|edit)",
          "text": "never branched, staged, committed, or pushed"
        },
        { "check": "tool_not_used", "tool": "Edit", "text": "edited nothing" },
        { "check": "tool_not_used", "tool": "Write", "text": "wrote nothing" },
        { "check": "git_diff_lines_max", "max": 0, "text": "left the worktree untouched" }
      ]
    },
    {
      "id": "p9-scope-and-plan",
      "section": "scope-and-plan",
      "tests": "a short 'get context, use sub-agents, then plan' request runs the full fan-out -> consult-advisor -> plan-format chain",
      "sandbox": "repo",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Agent", "Bash", "Edit", "Write"],
      "permission_mode": "default",
      "prompt": "Uninstalling is losing user data: backups that were edited after they were created get deleted anyway. Start by getting context — use sub-agents in parallel to decompose this — then plan the fix for me. Don't implement it.",
      "assertions": [
        { "check": "skill_invoked", "skill": "scope-and-plan", "text": "loaded the scope-and-plan skill" },
        {
          "check": "skill_invoked_before_tool",
          "skill": "scope-and-plan",
          "tool": "Agent",
          "pattern": "",
          "text": "loaded the skill before fanning out (gate 1)"
        },
        {
          "check": "parallel_tool_calls_min",
          "tool": "Agent",
          "count": 2,
          "text": "fanned out 2+ workers in one batch (gate 1)"
        },
        {
          "check": "tool_used_before_skill",
          "tool": "Agent",
          "skill": "consult-advisor",
          "text": "fanned out before consulting the advisor (gate 1 -> 3)"
        },
        { "check": "skill_invoked", "skill": "consult-advisor", "text": "refined through consult-advisor (gate 3)" },
        {
          "check": "tool_used_after_skill",
          "tool": "Agent",
          "skill": "consult-advisor",
          "text": "delegated to an advisor after loading consult-advisor (gate 3)"
        },
        {
          "check": "tool_used_after_skill",
          "tool": "Agent",
          "skill": "consult-advisor",
          "pattern": "Paths:.*Facts:.*Gaps:.*Approach:",
          "text": "sent the advisor a collapsed synthesis (gate 2)"
        },
        {
          "check": "skill_invoked_before_tool",
          "skill": "consult-advisor",
          "tool": "Skill",
          "pattern": "\"skill\": \"plan-format\"",
          "text": "consulted before planning (gate 3 -> 4)"
        },
        { "check": "skill_invoked", "skill": "plan-format", "text": "loaded plan-format (gate 4)" },
        { "check": "result_matches", "pattern": "```diff", "text": "plan shows the change as a diff" },
        { "check": "tool_not_used", "tool": "Edit", "text": "edited nothing" },
        { "check": "tool_not_used", "tool": "Write", "text": "wrote nothing" },
        { "check": "git_diff_lines_max", "max": 0, "text": "left the worktree untouched" }
      ]
    },
    {
      "id": "p10-scope-and-plan-skips",
      "section": "scope-and-plan",
      "tests": "a mechanical single-file edit does not trigger fan-out",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Agent", "Edit"],
      "permission_mode": "acceptEdits",
      "prompt": "In install.sh, change RELEASE_URL to https://example.invalid/releases/stable. Nothing else.",
      "assertions": [
        { "check": "tool_not_used", "tool": "Agent", "text": "did not fan out for a mechanical edit" },
        {
          "check": "skill_not_invoked",
          "skill": "scope-and-plan",
          "text": "did not load scope-and-plan for a mechanical edit"
        },
        { "check": "git_diff_files_subset", "files": ["install.sh"], "text": "touched only install.sh" },
        { "check": "git_diff_lines_max", "max": 2, "text": "changed at most one line" },
        {
          "check": "file_matches",
          "path": "install.sh",
          "pattern": "RELEASE_URL=[\"']?https://example\\.invalid/releases/stable",
          "text": "made the requested change"
        }
      ]
    },
    {
      "id": "p11-linkedin-triggers",
      "section": "linkedin",
      "tests": "an off-profile LinkedIn ask still loads the skill, which the old description excluded",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "AskUserQuestion"],
      "permission_mode": "acceptEdits",
      "prompt": "What should I post on LinkedIn to get noticed by recruiters?",
      "assertions": [
        { "check": "skill_invoked", "skill": "linkedin", "text": "loaded the linkedin skill" },
        { "check": "tool_not_used", "tool": "Edit", "text": "edited nothing" },
        { "check": "tool_not_used", "tool": "Write", "text": "wrote nothing" }
      ]
    },
    {
      "id": "p12-linkedin-routes",
      "section": "linkedin",
      "tests": "a single-area ask routes to that area's reference file",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill"],
      "permission_mode": "acceptEdits",
      "prompt": "My LinkedIn headline is \"Analyst at Acme\". I want a senior data engineer role in Sao Paulo, and the keywords from the job ads are Python, SQL, Airflow, dbt, and AWS. Fix my headline.",
      "assertions": [
        { "check": "skill_invoked", "skill": "linkedin", "text": "loaded the linkedin skill" },
        {
          "check": "skill_invoked_before_tool",
          "skill": "linkedin",
          "tool": "Read",
          "pattern": "references/headline\\.md",
          "text": "routed to the headline reference"
        },
        {
          "check": "result_matches",
          "pattern": "Data Engineer\\s*\\|",
          "text": "emitted the pipe-separated headline format"
        }
      ]
    },
    {
      "id": "p13-batch-independent-calls",
      "section": "1",
      "tests": "two independent lookups are issued in one batch, with no fan-out",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Skill"],
      "permission_mode": "acceptEdits",
      "prompt": "Two questions, no changes to anything: which curl flags does fetch_release use in install.sh, and how many assert_eq calls does test.sh make?",
      "assertions": [
        {
          "check": "parallel_tool_calls_min",
          "tool": "Read",
          "count": 2,
          "text": "batched both reads into one message"
        },
        { "check": "skill_not_invoked", "skill": "scope-and-plan", "text": "did not fan out for two named files" },
        { "check": "result_matches", "pattern": "fsSL", "text": "answered the install.sh question" },
        { "check": "result_matches", "pattern": "\\b2\\b", "text": "answered the test.sh question" },
        { "check": "git_diff_lines_max", "max": 0, "text": "left the worktree untouched" }
      ]
    }
  ]
}
