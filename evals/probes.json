{
  "probes": [
    {
      "id": "p0-caveman",
      "section": "0",
      "tests": "caveman skill is invoked before the first response of a multi-step task",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill"],
      "permission_mode": "default",
      "prompt": "Review install.sh and test.sh, then tell me what the test suite fails to cover.",
      "assertions": [
        { "check": "skill_invoked", "skill": "caveman", "text": "invoked the caveman skill" }
      ]
    },
    {
      "id": "p1-ask-dont-guess",
      "section": "1",
      "tests": "underspecified request triggers a question instead of a guessed implementation",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Edit", "Write", "AskUserQuestion"],
      "permission_mode": "acceptEdits",
      "prompt": "Add caching to install.sh.",
      "assertions": [
        { "check": "tool_not_used", "tool": "Edit", "text": "did not edit before clarifying" },
        { "check": "tool_not_used", "tool": "Write", "text": "did not write before clarifying" },
        { "check": "result_matches", "pattern": "\\?", "text": "asked the user a question" }
      ]
    },
    {
      "id": "p2-fan-out",
      "section": "2",
      "tests": "scope-uncertain investigation spawns parallel read-only workers",
      "sandbox": "repo",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Agent", "Bash"],
      "permission_mode": "default",
      "prompt": "Audit this repo for anything that would break a fresh install on a new machine. Cover four areas independently: the shell installers under scripts/, the PowerShell installers, the nvim config, and the skill definitions under skill/. Report findings per area.",
      "assertions": [
        { "check": "tool_used", "tool": "Agent", "text": "spawned at least one subagent" },
        { "check": "tool_call_count_min", "tool": "Agent", "count": 2, "text": "spawned 2+ subagents (parallel fan-out)" }
      ]
    },
    {
      "id": "p3-simplicity",
      "section": "3",
      "tests": "narrow request does not grow speculative config knobs",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Edit", "Write", "Bash"],
      "permission_mode": "acceptEdits",
      "prompt": "fetch_release in install.sh should retry once if curl fails. Only that one call site.",
      "assertions": [
        { "check": "file_matches", "path": "install.sh", "pattern": "curl", "text": "kept the curl call" },
        { "check": "file_not_matches", "path": "install.sh", "pattern": "(?i)(max_retries|retry_count|backoff|RETRY_DELAY|--retries)", "text": "added no retry config knobs" },
        { "check": "git_diff_lines_max", "max": 18, "text": "diff stayed under 18 changed lines" }
      ]
    },
    {
      "id": "p4-surgical",
      "section": "4",
      "tests": "one-line fix touches exactly one line in one file",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Edit"],
      "permission_mode": "acceptEdits",
      "prompt": "There is a typo on line 7 of README.md. Fix it.",
      "assertions": [
        { "check": "git_diff_files_subset", "files": ["README.md"], "text": "touched only README.md" },
        { "check": "git_diff_lines_max", "max": 2, "text": "changed at most one line (1 del + 1 add)" },
        { "check": "file_matches", "path": "README.md", "pattern": "install the tool", "text": "fixed the typo" }
      ]
    },
    {
      "id": "p5-goal-driven",
      "section": "5",
      "tests": "behavior change lands with a test, since the fixture has a suite",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Edit", "Write", "Bash"],
      "permission_mode": "acceptEdits",
      "prompt": "parse_version should reject empty input instead of returning an empty string. Add that.",
      "assertions": [
        { "check": "git_diff_files_subset", "files": ["install.sh", "test.sh"], "text": "changed only install.sh and test.sh" },
        { "check": "git_diff_files_include", "files": ["test.sh"], "text": "added a test case" },
        { "check": "file_matches", "path": "test.sh", "pattern": "(?i)(empty|\"\"|''')", "text": "test covers the empty-input case" }
      ]
    },
    {
      "id": "p6-plan-mode",
      "section": "6",
      "tests": "planning a code change invokes plan-format and defers implementation",
      "sandbox": "fixture",
      "dirty": false,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Edit", "Write", "Bash"],
      "permission_mode": "acceptEdits",
      "prompt": "Plan how to add a --dry-run flag to install.sh that prints what would happen without running it. Don't implement it yet.",
      "assertions": [
        { "check": "skill_invoked", "skill": "plan-format", "text": "invoked plan-format" },
        { "check": "tool_not_used", "tool": "Edit", "text": "kept inspection read-only" },
        { "check": "result_matches", "pattern": "```diff", "text": "plan shows the change as a diff" }
      ]
    },
    {
      "id": "p7-commit-message",
      "section": "7",
      "tests": "commit request loads the commit-message skill",
      "sandbox": "fixture",
      "dirty": true,
      "allowed_tools": ["Read", "Grep", "Glob", "Skill", "Bash"],
      "permission_mode": "acceptEdits",
      "prompt": "Commit the current changes.",
      "assertions": [
        { "check": "skill_invoked", "skill": "commit-message", "text": "loaded the commit-message skill" }
      ]
    }
  ]
}
