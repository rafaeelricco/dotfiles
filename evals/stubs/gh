#!/bin/sh
# Minimal `gh` for eval sandboxes: enough for create-pr's Step 2 inspection.
# Anything that would touch the network exits non-zero, so a probe can never
# open a real PR even if the model reaches Step 5.
case "$1 $2" in
  "repo view")   echo '{"defaultBranchRef":{"name":"main"},"nameWithOwner":"eval/fixture"}' ;;
  "pr view")     echo "no pull requests found for this branch" >&2; exit 1 ;;
  "pr list")     echo '[]' ;;
  "auth status") echo "Logged in to github.com as eval-runner" >&2 ;;
  *)             echo "gh stub: refusing '$*'" >&2; exit 1 ;;
esac
