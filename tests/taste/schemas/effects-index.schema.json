{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "assets/effects/index.json",
  "type": "object",
  "required": ["count", "effects", "families", "generated", "version"],
  "properties": {
    "version": {
      "type": "number"
    },
    "generated": {
      "type": "string"
    },
    "count": {
      "type": "number"
    },
    "families": {
      "type": "object"
    },
    "effects": {
      "type": "array"
    }
  }
}
