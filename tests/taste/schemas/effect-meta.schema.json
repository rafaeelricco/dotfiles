{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "assets/effects/<id>/meta.json (25 when written)",
  "type": "object",
  "required": [
    "bestOn",
    "cost",
    "family",
    "id",
    "intensity",
    "look",
    "motion",
    "name",
    "palettes",
    "tones",
    "treatment",
    "webgl"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "look": {
      "type": "string"
    },
    "bestOn": {
      "type": "array"
    },
    "motion": {
      "type": "string"
    },
    "cost": {
      "type": "string"
    },
    "palettes": {
      "type": "array"
    },
    "focal": {
      "type": "boolean"
    },
    "tones": {
      "type": "array"
    },
    "intensity": {
      "type": "string"
    },
    "webgl": {
      "type": "number"
    },
    "treatment": {
      "type": "boolean"
    },
    "random": {
      "type": "boolean"
    },
    "literal": {
      "type": "boolean"
    },
    "subjects": {
      "type": "array"
    },
    "avoidWith": {
      "type": "array"
    },
    "usesImg": {
      "type": "boolean"
    }
  }
}
