{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "skill/taste/scripts/**/*.mjs",
    "skill/taste/scripts/**/*.d.ts",
    "skill/taste/assets/**/*.js",
    "skill/ui/scripts/*.mjs"
  ]
}
